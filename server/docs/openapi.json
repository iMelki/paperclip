{
  "openapi": "3.0.0",
  "info": {
    "title": "Paperclip API",
    "description": "API for Paperclip AI - Autonomous Agent Workspace.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3100",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/agents": {
      "get": {
        "summary": "List all agents",
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "Array of agent configurations"
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "summary": "List projects",
        "operationId": "listProjects",
        "responses": {
          "200": {
            "description": "Array of projects"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}