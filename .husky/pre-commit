#!/usr/bin/env sh
set -eu

pwsh_path="$(command -v pwsh 2>/dev/null || true)"
if [ -n "$pwsh_path" ]; then
  exec node scripts/run-pre-commit.mjs "$pwsh_path"
else
  sh scripts/pre-commit-check.sh
fi
if node scripts/run-react-doctor.js; then
  react_doctor_status=0
else
  react_doctor_status=$?
fi

case "$react_doctor_status" in
  0) ;;
  2) echo "React Doctor is disabled: the exact local dependency is not pinned; receipt is incomplete." ;;
  *) exit "$react_doctor_status" ;;
esac
